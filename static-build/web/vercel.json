{
  "buildCommand": "",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!_expo/|assets/|fonts/|app\\.html).+)",
      "destination": "/app.html"
    }
  ]
}
